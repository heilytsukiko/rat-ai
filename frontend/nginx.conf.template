server {
    listen 80;
    root /usr/share/nginx/html;
    client_max_body_size 110m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
