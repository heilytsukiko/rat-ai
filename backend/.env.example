API_KEY=replace-with-a-random-secret-at-least-16-characters
DATA_DIR=./storage
MAX_UPLOAD_MB=100
MAX_PENDING_JOBS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYZER_COMMAND=["python", "/models/infer.py"]
ANALYSIS_TIMEOUT_SEC=240
# strict: contract with violation types and verified normative sources.
# experimental: raw detector candidates, no legal verdict (local development only).
ANALYSIS_MODE=strict
